# VoxelBooking Environment Configuration
# Production: the installer creates .env automatically during setup.
# Local/dev: copy this file to .env and adjust values before starting.

# ── Application ──
APP_NAME=VoxelBooking
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=en
FORCE_HTTPS=true

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voxelbooking
DB_USERNAME=root
DB_PASSWORD=

# ── Mail ──
# Mail is configured via the installation wizard (Step 3) or
# Admin → Settings → Email. Settings are stored in the database,
# not in this file. The wizard supports three transports:
#   smtp    — production SMTP server
#   mailpit — local dev mail capture (localhost:1025)
#   log     — writes to storage/logs/app.log (no sending)
