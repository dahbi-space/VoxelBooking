# VoxelBooking Environment Configuration
# Copy this file to .env and adjust values for your installation.

# ── Application ──
APP_NAME=VoxelBooking
APP_URL=https://your-domain.com
APP_DEBUG=false
APP_TIMEZONE=UTC
FORCE_HTTPS=true

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voxelbooking
DB_USERNAME=root
DB_PASSWORD=

# ── Mail (SMTP) ──
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
