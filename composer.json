{
    "name": "voxel/voxelbooking",
    "description": "Self-hosted multi-tenant booking system",
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "phpmailer/phpmailer": "^6.9",
        "robinvdvleuten/ulid": "^5.0",
        "rlanvin/php-rrule": "^2.4",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
